{%- comment -%} Usage: {% render 'icon-social', platform: 'instagram' %} {%- endcomment -%}
{%- case platform -%}
  {%- when 'instagram' -%}
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
      <rect x="3" y="3" width="18" height="18" rx="5"/>
      <circle cx="12" cy="12" r="4"/>
      <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none"/>
    </svg>
  {%- when 'facebook' -%}
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
      <path d="M15 4h-2.5A3.5 3.5 0 0 0 9 7.5V10H6.5v3H9v7h3v-7h2.5l.5-3H12V7.75c0-.69.56-1.25 1.25-1.25H15V4Z"/>
    </svg>
  {%- when 'tiktok' -%}
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M14 4v10.5a3.5 3.5 0 1 1-3-3.46"/>
      <path d="M14 4a5 5 0 0 0 5 5"/>
    </svg>
  {%- when 'youtube' -%}
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <rect x="3" y="6" width="18" height="12" rx="4"/>
      <path d="M10.5 9.5l4.5 2.5-4.5 2.5v-5Z" fill="currentColor" stroke="none"/>
    </svg>
{%- endcase -%}
