{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<footer class="site-footer surface-dark">
  <div class="container section-padding">
    <div class="site-footer__grid">
      <div class="site-footer__col site-footer__brand">
        <span class="site-header__wordmark" style="color: var(--bone);">RL Paws Co.</span>
        {%- if section.settings.blurb != blank -%}
          <div class="site-footer__blurb text-muted-inverse">{{ section.settings.blurb }}</div>
        {%- endif -%}
        {%- if section.settings.social_instagram != blank or section.settings.social_facebook != blank or section.settings.social_tiktok != blank or section.settings.social_youtube != blank -%}
          <div class="site-footer__social">
            {%- if section.settings.social_instagram != blank -%}
              <a href="{{ section.settings.social_instagram }}" aria-label="Instagram" class="site-header__icon-btn">{% render 'icon-social', platform: 'instagram' %}</a>
            {%- endif -%}
            {%- if section.settings.social_facebook != blank -%}
              <a href="{{ section.settings.social_facebook }}" aria-label="Facebook" class="site-header__icon-btn">{% render 'icon-social', platform: 'facebook' %}</a>
            {%- endif -%}
            {%- if section.settings.social_tiktok != blank -%}
              <a href="{{ section.settings.social_tiktok }}" aria-label="TikTok" class="site-header__icon-btn">{% render 'icon-social', platform: 'tiktok' %}</a>
            {%- endif -%}
            {%- if section.settings.social_youtube != blank -%}
              <a href="{{ section.settings.social_youtube }}" aria-label="YouTube" class="site-header__icon-btn">{% render 'icon-social', platform: 'youtube' %}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- for menu_setting in (1..3) -%}
        {%- assign menu_id_key = 'footer_menu_' | append: menu_setting -%}
        {%- assign title_key = 'footer_menu_' | append: menu_setting | append: '_title' -%}
        {%- assign menu_handle = section.settings[menu_id_key] -%}
        {%- assign menu = linklists[menu_handle] -%}
        {%- if menu -%}
          <div class="site-footer__col">
            <h3 class="site-footer__col-title">{{ section.settings[title_key] }}</h3>
            <ul>
              {%- for link in menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="site-footer__bottom">
      {%- if section.settings.show_payment_icons -%}
        <ul class="site-footer__payment-icons" aria-label="{{ 'footer.payment_methods' | t | default: 'Payment methods accepted' }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'site-footer__payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <p class="site-footer__copyright text-muted-inverse">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_suffix }}
      </p>

      {%- if section.settings.legal_menu != blank -%}
        <ul class="site-footer__legal">
          {%- for link in linklists[section.settings.legal_menu].links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "richtext",
      "id": "blurb",
      "label": "Brand blurb",
      "default": "<p>Engineered pet gear, tested in the real world. Proudly South African.</p>"
    },
    {
      "type": "header",
      "content": "Social links"
    },
    { "type": "url", "id": "social_instagram", "label": "Instagram" },
    { "type": "url", "id": "social_facebook", "label": "Facebook" },
    { "type": "url", "id": "social_tiktok", "label": "TikTok" },
    { "type": "url", "id": "social_youtube", "label": "YouTube" },
    {
      "type": "header",
      "content": "Column 1"
    },
    { "type": "text", "id": "footer_menu_1_title", "label": "Title", "default": "Shop" },
    { "type": "link_list", "id": "footer_menu_1", "label": "Menu", "default": "footer" },
    {
      "type": "header",
      "content": "Column 2"
    },
    { "type": "text", "id": "footer_menu_2_title", "label": "Title", "default": "Support" },
    { "type": "link_list", "id": "footer_menu_2", "label": "Menu" },
    {
      "type": "header",
      "content": "Column 3"
    },
    { "type": "text", "id": "footer_menu_3_title", "label": "Title", "default": "Company" },
    { "type": "link_list", "id": "footer_menu_3", "label": "Menu" },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright_suffix",
      "label": "Copyright suffix",
      "default": "All rights reserved."
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal menu",
      "info": "e.g. Privacy Policy (POPIA), Terms of Service"
    }
  ]
}
{% endschema %}
