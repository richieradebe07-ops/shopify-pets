{{ 'section-testimonial-carousel.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <div class="testimonial-carousel section-padding">
    <div class="container">
      <div class="testimonial-carousel__header">
        <div data-reveal>
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h2>{{ section.settings.heading }}</h2>
        </div>
        <div class="testimonial-carousel__controls">
          <button type="button" class="site-header__icon-btn" data-carousel-prev aria-label="{{ 'testimonials.previous' | t | default: 'Previous testimonial' }}">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg>
          </button>
          <button type="button" class="site-header__icon-btn" data-carousel-next aria-label="{{ 'testimonials.next' | t | default: 'Next testimonial' }}">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>

      <ul class="testimonial-carousel__track" data-carousel-track tabindex="0" aria-label="{{ 'testimonials.label' | t | default: 'Customer testimonials' }}">
        {%- for block in section.blocks -%}
          <li class="testimonial-card" data-carousel-slide {{ block.shopify_attributes }}>
            {% render 'star-rating', rating: block.settings.rating %}
            <blockquote class="testimonial-card__quote">&ldquo;{{ block.settings.quote }}&rdquo;</blockquote>
            <div class="testimonial-card__author">
              {%- if block.settings.photo -%}
                <img
                  src="{{ block.settings.photo | image_url: width: 96 }}"
                  alt=""
                  width="48"
                  height="48"
                  loading="lazy"
                >
              {%- endif -%}
              <div>
                <p class="testimonial-card__name">{{ block.settings.author }}</p>
                {%- if block.settings.location != blank -%}
                  <p class="text-muted testimonial-card__location">{{ block.settings.location }}</p>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
  <script src="{{ 'section-testimonial-carousel.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Real owners, real dogs"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Don't take our word for it"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Customer photo"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The harness actually stopped the pulling. My arm has never been happier."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Sarah M."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Cape Town"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "default": {
    "blocks": [
      { "type": "testimonial" },
      { "type": "testimonial", "settings": { "author": "Devon P.", "location": "Johannesburg", "quote": "Ordered Monday, walking my Border Collie in it by Thursday. Quality is obvious the second you touch it." } },
      { "type": "testimonial", "settings": { "author": "Naledi K.", "location": "Durban", "quote": "Finally gear that doesn't look like a toy. My vet actually complimented the harness fit." } }
    ]
  },
  "presets": [
    { "name": "Testimonials" }
  ]
}
{% endschema %}
