{{ 'section-announcement-bar.css' | asset_url | stylesheet_tag }}

{%- assign message_count = section.blocks.size -%}

<div
  class="announcement-bar"
  id="AnnouncementBar-{{ section.id }}"
  data-announcement-bar
  data-storage-key="rlpaws-announcement-dismissed"
  data-rotate-seconds="{{ section.settings.rotate_seconds }}"
  role="region"
  aria-label="{{ 'announcement.label' | t | default: 'Announcement' }}"
>
  <div class="container announcement-bar__inner">
    <div class="announcement-bar__track" data-announcement-track>
      {%- for block in section.blocks -%}
        <div
          class="announcement-bar__item{% if forloop.first %} is-active{% endif %}"
          data-announcement-item
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
          {%- else -%}
            <span>{{ block.settings.text | escape }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <button
      type="button"
      class="announcement-bar__dismiss"
      data-announcement-dismiss
      aria-label="{{ 'announcement.dismiss' | t | default: 'Dismiss announcement' }}"
    >
      <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false">
        <path d="M1 1L15 15M15 1L1 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
</div>

{%- if message_count > 0 -%}
  <script src="{{ 'section-announcement-bar.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "div",
  "settings": [
    {
      "type": "range",
      "id": "rotate_seconds",
      "label": "Rotate every",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5,
      "info": "Only applies when more than one message is added."
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message",
          "default": "Free shipping on orders over R600"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "message",
        "settings": {
          "text": "Free shipping on orders over R600"
        }
      },
      {
        "type": "message",
        "settings": {
          "text": "30-day returns — no fine print"
        }
      }
    ]
  }
}
{% endschema %}
