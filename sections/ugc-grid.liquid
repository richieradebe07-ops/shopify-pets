{{ 'section-ugc-grid.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <div class="ugc-grid section-padding">
    <div class="container">
      <div class="ugc-grid__header" data-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.handle != blank -%}
          <a href="https://instagram.com/{{ section.settings.handle | remove: '@' }}" class="ugc-grid__handle">
            {{ section.settings.handle }}
          </a>
        {%- endif -%}
      </div>

      <div class="ugc-grid__tiles">
        {%- for block in section.blocks -%}
          <a
            href="{{ block.settings.link | default: '#' }}"
            class="ugc-tile"
            {{ block.shopify_attributes }}
            {% if block.settings.link == blank %}tabindex="-1" aria-hidden="true"{% endif %}
          >
            {%- if block.settings.image -%}
              <img
                src="{{ block.settings.image | image_url: width: 500 }}"
                srcset="{{ block.settings.image | image_url: width: 300 }} 300w, {{ block.settings.image | image_url: width: 500 }} 500w"
                sizes="(min-width: 48em) 16vw, 33vw"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                alt="{{ block.settings.image.alt | escape }}"
                loading="lazy"
              >
            {%- else -%}
              <div class="ugc-tile__placeholder"></div>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Instagram grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Tag us"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "#RLPawsCo in the wild"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram handle",
      "default": "@rlpawsco"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 6,
  "default": {
    "blocks": [
      { "type": "tile" },
      { "type": "tile" },
      { "type": "tile" },
      { "type": "tile" },
      { "type": "tile" },
      { "type": "tile" }
    ]
  },
  "presets": [
    {
      "name": "Instagram grid",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
