{{ 'section-newsletter.css' | asset_url | stylesheet_tag }}

<div class="newsletter surface-dark">
  <div class="newsletter__grid">
    <div class="newsletter__media" aria-hidden="true">
      {%- if section.settings.image -%}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          srcset="{{ section.settings.image | image_url: width: 700 }} 700w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
          sizes="(min-width: 48em) 50vw, 100vw"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          alt=""
          loading="lazy"
        >
      {%- else -%}
        <div class="newsletter__media-placeholder"></div>
      {%- endif -%}
    </div>

    <div class="newsletter__content">
      <div class="container newsletter__inner" data-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.body != blank -%}
          <div class="text-muted newsletter__body">{{ section.settings.body }}</div>
        {%- endif -%}

        {%- form 'customer', id: 'NewsletterForm', class: 'newsletter__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="newsletter__field">
            <label class="visually-hidden" for="NewsletterEmail">
              {{ 'newsletter.email_label' | t | default: 'Email address' }}
            </label>
            <input
              type="email"
              name="contact[email]"
              id="NewsletterEmail"
              placeholder="{{ 'newsletter.placeholder' | t | default: 'you@email.com' }}"
              autocomplete="email"
              required
              data-newsletter-input
            >
            <button type="submit" class="btn btn--primary" data-magnetic>
              {{ section.settings.cta_label | default: 'Subscribe' | escape }}
            </button>
          </div>
          <p class="newsletter__error" data-newsletter-error hidden>
            {{ 'newsletter.invalid_email' | t | default: 'Enter a valid email address.' }}
          </p>

          {%- if form.posted_successfully? -%}
            <p class="newsletter__success" role="status">
              {{ 'newsletter.success' | t | default: "You're on the list — welcome to the pack." }}
            </p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="newsletter__error" role="alert">
              {{ form.errors.messages['email'] | default: 'Something went wrong — please try again.' }}
            </p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</div>
<script src="{{ 'section-newsletter.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Join the pack"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get 10% off your first order"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>New gear drops, real training tips, and first access to restocks — no spam, ever.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Subscribe"
    }
  ],
  "presets": [
    { "name": "Newsletter" }
  ]
}
{% endschema %}
