<div class="main-404 section-padding">
  <div class="container main-404__inner">
    <p class="eyebrow">{{ 'errors.404_eyebrow' | t | default: '404' }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <p class="text-muted">{{ section.settings.body }}</p>
    <a href="{{ routes.root_url }}" class="btn btn--primary">
      {{ section.settings.button_label | escape }}
    </a>
  </div>
</div>

<style>
  .main-404__inner {
    max-width: 32rem;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }
</style>

{% schema %}
{
  "name": "404 page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "This page ran off like an unleashed dog."
    },
    {
      "type": "text",
      "id": "body",
      "label": "Body",
      "default": "We couldn't find the page you were looking for."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Back to home"
    }
  ]
}
{% endschema %}
