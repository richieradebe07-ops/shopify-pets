{{ 'section-stats-band.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <div class="stats-band surface-dark section-padding">
    <div class="container">
      {%- if section.settings.heading != blank -%}
        <h2 class="stats-band__heading" data-reveal>{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div class="stats-band__grid">
        {%- for block in section.blocks -%}
          <div class="stats-band__stat" data-reveal style="--reveal-index: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
            <p class="stats-band__number">
              <span
                data-counter
                data-target="{{ block.settings.value }}"
                data-decimals="{{ block.settings.decimals }}"
              >0</span>{{ block.settings.suffix }}
            </p>
            <p class="stats-band__label">{{ block.settings.label | escape }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
  <script src="{{ 'section-stats-band.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Stats band",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Numbers that back up the noise"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "number",
          "id": "value",
          "label": "Value",
          "default": 12000
        },
        {
          "type": "number",
          "id": "decimals",
          "label": "Decimal places",
          "default": 0
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Suffix",
          "default": "+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Happy pets"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "default": {
    "blocks": [
      { "type": "stat", "settings": { "value": 12000, "suffix": "+", "label": "Happy pets" } },
      { "type": "stat", "settings": { "value": 38000, "suffix": "+", "label": "Products shipped" } },
      { "type": "stat", "settings": { "value": 4.9, "decimals": 1, "suffix": "★", "label": "Average rating" } }
    ]
  },
  "presets": [
    { "name": "Stats band" }
  ]
}
{% endschema %}
